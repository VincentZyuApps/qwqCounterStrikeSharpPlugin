# 🧾 统一文本文件为 LF，减少 Windows 与 Linux 间的无意义差异
* text=auto eol=lf

# 📊 Markdown 默认不计入统计，仅保留根目录英文 README
*.md linguist-language=Markdown linguist-detectable=false linguist-documentation=true
README.md linguist-language=Markdown linguist-detectable=true linguist-documentation=false
README.zh-cn.md linguist-language=Markdown linguist-detectable=false linguist-documentation=true

# 🧮 将所有已追踪的源码、项目文件与自动化脚本计入 GitHub Linguist 语言统计
*.cs linguist-language=C# linguist-detectable=true
*.csproj linguist-language=XML linguist-detectable=true
*.py linguist-language=Python linguist-detectable=true linguist-documentation=false linguist-vendored=false linguist-generated=false
*.yml linguist-language=YAML linguist-detectable=true linguist-documentation=false linguist-vendored=false linguist-generated=false
*.yaml linguist-language=YAML linguist-detectable=true linguist-documentation=false linguist-vendored=false linguist-generated=false

# 📦 常见二进制产物与图片保持原始字节
*.dll binary
*.so binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
